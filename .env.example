# Application
APP_NAME=Tudso
APP_URL=http://localhost:3000
APP_ENV=development
# Synced from package.json on each release. The server reads the package version.
APP_VERSION=1.1.1

# Desktop app API origin. Baked in at Vite / Electron build time.
# Local:  http://localhost:3000
# Live:   https://tudso.com
VITE_SERVER_URL=http://localhost:3000
VITE_APP_NAME=Tudso

# Google OAuth redirect URI lives on the API (see server/.env.example):
# {APP_URL}/auth/desktop/oauth/callback
# Local:  http://localhost:3000/auth/desktop/oauth/callback
# Live:   https://tudso.com/auth/desktop/oauth/callback
