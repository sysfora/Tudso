{
  "name": "tudso",
  "productName": "Tudso",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight floating desktop AI assistant",
  "author": "Sysfora",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,renderer,electron -c blue,cyan,magenta \"npm run dev:server\" \"vite\" \"node scripts/electron-dev.mjs\"",
    "dev:server": "cd server && npm run dev",
    "dev:renderer": "vite",
    "build": "npm run build:server && tsc -b && vite build && node scripts/build-electron.mjs",
    "build:server": "cd server && npm install && npm run build",
    "build:electron": "node scripts/build-electron.mjs",
    "lint": "eslint . && cd server && npm run lint",
    "typecheck": "tsc -b && cd server && npm run typecheck",
    "test": "cd server && npm test",
    "build:desktop": "vite build && node scripts/build-electron.mjs",
    "package": "npm run build:desktop && electron-builder --publish never",
    "package:win": "npm run build:desktop && electron-builder --win --publish never",
    "package:mac": "npm run build:desktop && electron-builder --mac --publish never",
    "package:linux": "npm run build:desktop && electron-builder --linux --publish never",
    "dev:electron": "node scripts/electron-dev.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "koffi": "^3.1.5",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
