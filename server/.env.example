# Application
APP_NAME=Tudso
APP_URL=http://localhost:3000
APP_ENV=development
APP_VERSION=1.0.0
PORT=3000

# PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# Stripe
# Use one set of keys (test OR live). Do not set both — later keys overwrite earlier ones.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

STRIPE_PRICE_FREE=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# Stripe webhook endpoint. Add this URL in Stripe Dashboard → Developers → Webhooks
# (or `stripe listen --forward-to` for local).
# Local:  {APP_URL}/webhooks/stripe
#         http://localhost:3000/webhooks/stripe
# Live:   https://tudso.com/webhooks/stripe
#
# Events to send (API version can match the Dashboard default):
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.paid
#   invoice.payment_failed
# The first four sync the user's plan. invoice.paid / invoice.payment_failed
# are accepted and covered by subscription.updated.

# AI (backend-only; never expose to the renderer)
AI_PROVIDER=openai
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...

# Authentication
AUTH_CALLBACK_SCHEME=tudso
AUTH_CALLBACK_HOST=auth/callback
AUTH_SESSION_TTL_MS=604800000
# Google OAuth redirect URI. Register this exact URL in Google Cloud
# (Authorized redirect URIs) and in PocketBase → users → OAuth2 → Google.
# Local:  {APP_URL}/auth/desktop/oauth/callback
#         http://localhost:3000/auth/desktop/oauth/callback
# Live:   https://tudso.com/auth/desktop/oauth/callback

# Security
JWT_SECRET=change-to-random-32-byte-secret
ENCRYPTION_KEY=change-to-random-32-byte-key

# Desktop updates (optional)
LATEST_VERSION_STABLE=0.1.0
LATEST_VERSION_BETA=0.1.0
LATEST_VERSION_ALPHA=0.1.0
UPDATE_DOWNLOAD_URL=
UPDATE_RELEASE_NOTES_URL=
